APP_NAME=DeltaForce AI
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K_CANDIDATES=24
TOP_K_CONTEXT=7
MIN_RETRIEVAL_SCORE=0.36
MAX_CONTEXT_CHARS=14000
TEMPERATURE=0.15
MAX_TOKENS=1200
EMPTY_RESPONSE_RETRY_TOKENS=1800
RETRY_CONTEXT_CHARS=6500
LMSTUDIO_REQUEST_TIMEOUT=120
USE_RESPONSES_FALLBACK=true
DISABLE_QWEN_THINKING=true
LEXICAL_BONUS_WEIGHT=0.28
